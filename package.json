{
  "name": "stingy-ai",
  "version": "0.1.0",
  "description": "Cut ~80% of AI agent input & tool-call token waste with a 10-Coin Turn Budget for Claude Code, Cursor, and Antigravity.",
  "type": "module",
  "bin": {
    "stingy": "./bin/stingy.mjs"
  },
  "scripts": {
    "start": "node ./bin/stingy.mjs",
    "roast": "node ./bin/stingy.mjs roast",
    "audit": "node ./bin/stingy.mjs audit",
    "init": "node ./bin/stingy.mjs init",
    "benchmark": "node ./benchmarks/run-benchmark.mjs",
    "benchmark:live-ab": "node ./benchmarks/measure-live-ab.mjs",
    "test": "node --test"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "antigravity",
    "ai-agent",
    "token-optimization",
    "context-compression",
    "caveman",
    "ponytail",
    "mcp",
    "skill"
  ],
  "license": "MIT",
  "homepage": "https://kuro0no.github.io/stingy/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kuro0No/stingy.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
